# Caddy production routing (architecture.md §2)
# Automatic TLS via the DOMAIN env var (Caddy serves /etc/caddy/config from caddy_config volume).
# WebSocket upgrades are handled automatically by Caddy's reverse_proxy.

{$DOMAIN}

# /sync/* -> PowerSync (WebSocket + HTTP)
handle_path /sync/* {
	reverse_proxy powersync:8080
}

# everything else -> web app
handle {
	reverse_proxy web:3000
}

# local dev variant (no TLS): uncomment and comment the {$DOMAIN} block above
