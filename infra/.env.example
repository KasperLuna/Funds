# Copy to .env and fill in real values.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=funds
DATABASE_URL=postgres://postgres:change-me@postgres:5432/funds

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=base64-public-key
VAPID_PRIVATE_KEY=base64-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- Cron / webhooks ---
CRON_SECRET=change-me
BACKEND_BASE_URL=https://example.com

# --- Host port bindings (cloudflared targets; bound to 127.0.0.1 only) ---
# Defaults live in docker-compose.yml; set here to override.
WEB_HOST_PORT=13000
POWERSYNC_HOST_PORT=18080

# --- TLS / domain ---
DOMAIN=example.com

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-char-min
# Public origin of the app. Must match an "Authorized JavaScript origin" below.
PUBLIC_APP_URL=http://localhost:3000
# Callback URLs the app is allowed to use. Defaults to [PUBLIC_APP_URL].
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (Social sign-in) ---
# Enables the "Continue with Google" button on /signin. The provider is only
# registered in server/auth.ts when BOTH GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# are set. After changing these, restart `next dev` (env is read at startup).
#
# Google Cloud Console setup:
#   1. APIs & Services > OAuth consent screen > Credentials > Create OAuth Client ID (Web application)
#   2. "Authorized JavaScript origins"  -> add {PUBLIC_APP_URL}  (e.g. http://localhost:3000)
#   3. "Authorized redirect URIs"       -> add {PUBLIC_APP_URL}/api/auth/callback/google
#      (Better Auth's default OAuth callback; dev example: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# --- PowerSync ---
# HTTP(S) base URL of the PowerSync service. The SDK appends /sync/stream, so
# the scheme must be http(s), never ws:// (a ws:// endpoint silently breaks sync).
# IMPORTANT: `http://powersync:8080` (the docker-internal hostname) only works
# for the app when it runs INSIDE the docker network. For a LOCAL `next dev` on
# the host, use the published port: http://localhost:${POWERSYNC_HOST_PORT}
# (default 18080) — otherwise the browser cannot resolve "powersync" and sync
# fails with NetworkError.
POWER_SYNC_URL=http://localhost:8080
POWER_SYNC_SECRET=change-me
# Shared secret used to sign PowerSync client JWTs (HS256). Plaintext secret the app
# backend uses to mint tokens; must carry `user_id` and `sub` claims and
# `aud` == "powersync" (match client_auth.audience in powersync.yaml).
JWT_SECRET=change-me-at-least-32-characters
# base64url encoding of JWT_SECRET, required by the service's HS256 `oct` key.
# MUST equal the secret the PowerSync service validates with (PS_JWT_SECRET_B64URL
# in docker-compose) — a mismatch makes the service reject tokens (PSYNC_S2101).
# Dev default (matches the compose dev container): dGVzdC1zZWNyZXQta2V5LWZvci1kZXYtb25seQ
# generate with: printf '%s' "$JWT_SECRET" | base64 | tr '+/' '-_' | tr -d '=\n'
POWER_SYNC_JWT_SECRET_B64URL=change-me

# --- CoinGecko ---
COINGECKO_API_KEY=change-me
