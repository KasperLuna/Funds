# Copy to .env and fill in real values.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=funds
DATABASE_URL=postgres://postgres:change-me@postgres:5432/funds

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=base64-public-key
VAPID_PRIVATE_KEY=base64-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- Cron / webhooks ---
CRON_SECRET=change-me
BACKEND_BASE_URL=https://example.com
PUBLIC_APP_URL=https://example.com

# --- TLS / domain ---
DOMAIN=example.com

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-char-min
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# --- PowerSync ---
POWER_SYNC_URL=ws://powersync:8080
POWER_SYNC_SECRET=change-me

# --- CoinGecko ---
COINGECKO_API_KEY=change-me
