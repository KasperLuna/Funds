# Copy to .env and fill in real values.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=funds
# Container-style URL: the web container reaches postgres via the compose
# service DNS (`postgres`). Host-side tooling (CI migrate) uses a separate
# `localhost`-style URL from the DATABASE_URL GitHub secret.
DATABASE_URL=postgres://postgres:change-me@postgres:5432/funds

# --- Web Push (VAPID) ---
# Generate with `node scripts/gen-vapid.mjs` (PKCS8 DER private key). A raw
# 32-byte `web-push`-CLI private key is also accepted — both parse server-side.
VAPID_PUBLIC_KEY=base64-public-key
VAPID_PRIVATE_KEY=base64-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- Cron / webhooks ---
CRON_SECRET=change-me
BACKEND_BASE_URL=https://example.com

# --- Host port bindings (cloudflared targets; bound to 127.0.0.1 only) ---
# Defaults live in docker-compose.yml; set here to override.
WEB_HOST_PORT=13000

# --- TLS / domain ---
DOMAIN=example.com

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-char-min
# Public origin of the app. Must match an "Authorized JavaScript origin" below.
PUBLIC_APP_URL=http://localhost:3000
# Callback URLs the app is allowed to use. Defaults to [PUBLIC_APP_URL].
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (Social sign-in) ---
# Enables the "Continue with Google" button on /signin. The provider is only
# registered in server/auth.ts when BOTH GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# are set. After changing these, restart `next dev` (env is read at startup).
#
# Google Cloud Console setup:
#   1. APIs & Services > OAuth consent screen > Credentials > Create OAuth Client ID (Web application)
#   2. "Authorized JavaScript origins"  -> add {PUBLIC_APP_URL}  (e.g. http://localhost:3000)
#   3. "Authorized redirect URIs"       -> add {PUBLIC_APP_URL}/api/auth/callback/google
#      (Better Auth's default OAuth callback; dev example: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# --- CoinGecko ---
COINGECKO_API_KEY=change-me

# --- Worker (ops/worker, runs in compose; reads VAPID_* + DATABASE_URL above) ---
# Reminder deep links. Falls back to PUBLIC_APP_URL; set only to override.
# APP_URL=https://funds.example.com
# Alternative auth header for cron trigger endpoints (else CRON_SECRET bearer).
# CRON_AUTH=change-me

# --- Image tags (rarely set; default `latest` for both images) ---
# WEB_IMAGE_TAG=latest

# --- Legacy (unused — do not add on fresh setups) ---
# PocketBase-era leftovers with zero code readers (verified 2026-09-19):
# JWT_SECRET, POWER_SYNC_URL, POWER_SYNC_INTERNAL_URL, POWER_SYNC_SECRET,
# PS_DATABASE_URL. BACKEND_BASE_URL is likewise dead. The REMINDER_ENDPOINT
# GitHub secret is the same story — safe to delete.
