{
  "name": "funds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "db:migrate": "pnpm --filter @funds/db run migrate",
    "db:seed": "pnpm --filter @funds/db run seed",
    "db:clean": "pnpm --filter @funds/db run clean",
    "db:migrate:pb": "pnpm --filter @funds/web run migrate:pb",
    "db:check": "pnpm --filter @funds/db run check"
  },
  "devDependencies": {
    "eslint": "^9",
    "fast-check": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}