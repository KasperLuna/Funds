#!/usr/bin/env bash
# Verification + image build gate, moved out of CI (pipeline is deploy-only:
# the proxy host never builds, it pulls from ghcr.io).
# Enable with: git config core.hooksPath .githooks
# Skip the (slow, qemu) image build+push with: SKIP_DOCKER_PUSH=1 git commit
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# db + web tests need a throwaway postgres on 127.0.0.1:54329 (funds_test).
if ! docker exec funds-test-pg pg_isready -U postgres -d funds_test >/dev/null 2>&1; then
  docker rm -f funds-test-pg >/dev/null 2>&1 || true
  docker run -d --name funds-test-pg \
    -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=funds_test \
    -p 127.0.0.1:54329:5432 postgres:16-alpine >/dev/null
  for i in $(seq 1 60); do
    docker exec funds-test-pg pg_isready -U postgres -d funds_test >/dev/null 2>&1 && break
    sleep 1
  done
fi

pnpm run lint
pnpm run typecheck
pnpm run test
# db:check catches schema drift (a migration generated but never applied)
# against the freshly-migrated throwaway postgres before anything ships.
pnpm run db:check

# Build + publish linux/amd64 images the host deploys. Only when build-relevant
# files are staged (else skip: deploy keeps the existing :latest).
if [ "${SKIP_DOCKER_PUSH:-0}" != "1" ] &&
   git diff --cached --name-only | rg -q '(^apps/web/|^packages/|Dockerfile$|^ops/worker|^pnpm-|^package.json$|^infra/docker-compose.yml$)'; then
  # auth needed once: echo <PAT> | docker login ghcr.io -u KasperLuna --password-stdin
  docker buildx build --platform linux/amd64 --push \
    -t ghcr.io/kasperluna/funds-web:latest \
    -f apps/web/Dockerfile .
  docker buildx build --platform linux/amd64 --push \
    -t ghcr.io/kasperluna/funds-worker:latest \
    -f ops/worker/Dockerfile .
fi